PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=al_yahya_restaurant

# Always false outside of a throwaway local DB — schema is managed by migrations
# (npm run migration:run), not by TypeORM auto-sync, once this is set up.
DB_SYNCHRONIZE=false

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:3000
# The FRONTEND's URL, not this API's — used to build links in emails
# (e.g. the invitation link in mail.service.ts), which users open in a browser
# against the Next.js app, not this NestJS server.
APP_URL=http://localhost:3000
INVITE_TOKEN_EXPIRES_IN_HOURS=48

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Al-Yahya Restaurant <no-reply@example.com>"

# en | ar
DEFAULT_LOCALE=en

# Used once, by `npm run seed`, to bootstrap the single Super Admin account.
SUPER_ADMIN_NAME_EN=
SUPER_ADMIN_NAME_AR=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=

# Firebase Storage — every uploaded file (company logo, and any future
# uploads) is stored here via src/modules/storage/firebase-storage.service.ts,
# not on local disk. Get these from Firebase Console → Project settings →
# Service accounts → Generate new private key (project_id/client_email/
# private_key come straight from that downloaded JSON — never commit it).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the JSON's "private_key" value verbatim, wrapped in double quotes,
# keeping its literal \n sequences — do not convert them to real newlines here.
FIREBASE_PRIVATE_KEY=
# From Firebase Console → Storage, the bucket name (e.g. "your-project.appspot.com").
FIREBASE_STORAGE_BUCKET=
